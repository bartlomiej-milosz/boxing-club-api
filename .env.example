# Use URL-safe generated passwords with local Compose.
# Local development only. Copy to .env and replace both passwords.
# The database is bound to loopback, not the public network.
POSTGRES_PORT=55432
POSTGRES_PASSWORD=replace-owner-password
APP_DB_PASSWORD=replace-app-password
DATABASE_URL=postgresql+psycopg://boxing_app:replace-app-password@127.0.0.1:55432/boxing_club
MIGRATION_DATABASE_URL=postgresql+psycopg://boxing_owner:replace-owner-password@127.0.0.1:55432/boxing_club

APP_PORT=8000
